{"rules":[{"effect":"deny","id":"no-huge-spend-ever","locked":true,"note":"Locked: no plan approval can release a spend over 10000.","when":"permission_class == 'SPEND' && payload.amount > 10000"},{"effect":"deny","id":"no-delete-ever","locked":true,"when":"permission_class == 'DELETE'"},{"effect":"ask","id":"spend-ask","when":"permission_class == 'SPEND'"},{"effect":"ask","id":"deploy-ask","when":"permission_class == 'DEPLOY'"},{"effect":"ask","id":"comms-ask","when":"permission_class == 'COMMUNICATE'"},{"effect":"ask","id":"publish-ask","when":"permission_class == 'PUBLISH'"},{"effect":"allow","id":"allow-rest","when":"true"}]}